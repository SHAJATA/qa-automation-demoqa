            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{username}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cases: API-AC-004\n\nObserved: returns false until a token has been generated for the user (OBS-API-06)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Prerequisite guard: skip (reported as not run) instead of sending a request with missing or stale data.",
                  "if (!pm.environment.get('userId') || !pm.environment.get('authToken')) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = undefined; }",
                  "pm.test('API-AC-004 | status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('API-AC-004 | body is exactly true', () => pm.expect(body).to.equal(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User (initial)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Account/v1/User/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Account",
                "v1",
                "User",
                "{{userId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Cases: API-AC-003, API-AC-005"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Prerequisite guard: skip (reported as not run) instead of sending a request with missing or stale data.",
                  "if (!pm.environment.get('userId') || !pm.environment.get('authToken')) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = undefined; }",
                  "// A 200 on this protected endpoint is the proof that the token is usable.",
                  "pm.test('API-AC-003 | token is accepted (status 200 OK)', () => pm.response.to.have.status(200));",
                  "pm.test('API-AC-005 | body matches the user schema', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"userId\",\"username\",\"books\"],\"properties\":{\"userId\":{\"type\":\"string\"},\"username\":{\"type\":\"string\"},\"books\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"isbn\",\"title\"]}}}}));",
                  "pm.test('API-AC-005 | identity matches the created user', () => {",
                  "  pm.expect(body.userId).to.eql(pm.environment.get('userId'));",
                  "  pm.expect(body.username).to.eql(pm.environment.get('username'));",
                  "});",
                  "pm.test('API-AC-005 | initial book list is empty', () => pm.expect(body.books).to.eql([]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - BookStore lifecycle",
      "item": [
        {
          "name": "Get Books (catalog)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "BookStore",
                "v1",
                "Books"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Cases: API-BS-001"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clear the previous selection so a failed catalog read can never reuse an old ISBN.",
                  "pm.environment.unset('selectedIsbn'); pm.environment.unset('selectedTitle');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = undefined; }",
                  "const FIELDS = ['isbn', 'title', 'subTitle', 'author', 'publish_date', 'publisher', 'pages', 'description', 'website'];",
                  "pm.test('API-BS-001 | status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('API-BS-001 | catalog is a non-empty books array', () => pm.expect(body.books).to.be.an('array').that.is.not.empty);",
                  "pm.test('API-BS-001 | every book has the documented BookModal fields', () => {",
                  "  body.books.forEach(b => pm.expect(b, b.isbn).to.include.all.keys(...FIELDS));",
                  "});",
                  "pm.test('API-BS-001 | first ISBN is 13 digits', () => pm.expect(body.books[0].isbn).to.match(/^\\d{13}$/));",
                  "if (pm.response.code === 200 && body && Array.isArray(body.books) && /^\\d{13}$/.test((body.books[0] || {}).isbn)) {",
                  "  pm.environment.set('selectedIsbn', body.books[0].isbn);",
                  "  pm.environment.set('selectedTitle', body.books[0].title);",
                  "}"
                ]
              }
            }
          ]
        },
