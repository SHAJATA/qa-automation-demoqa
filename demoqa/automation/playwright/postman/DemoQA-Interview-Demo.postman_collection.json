    {
      "name": "4 - Cleanup",
      "item": [
        {
          "name": "Cleanup - Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Account/v1/User/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Account",
                "v1",
                "User",
                "{{userId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Cases: API-AC-006"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cleanup runs whenever this run created a user, even if earlier steps failed.",
                  "if (!pm.environment.get('userId')) { pm.execution.skipRequest(); }",
                  "else if (!pm.environment.get('authToken') && pm.environment.get('userPassword')) {",
                  "  // Token missing (e.g. Generate Token failed): try once more so the owned account can still be deleted.",
                  "  pm.sendRequest({",
                  "    url: pm.environment.get('baseUrl') + '/Account/v1/GenerateToken', method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ userName: pm.environment.get('username'), password: pm.environment.get('userPassword') }) },",
                  "  }, (err, res) => {",
                  "    const b = !err && res.code === 200 ? res.json() : {};",
                  "    if (b.status === 'Success' && b.token) pm.environment.set('authToken', b.token);",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API-AC-006 | status is 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('API-AC-006 | response body is empty', () => pm.expect(pm.response.text()).to.eql(''));",
                  "// The password is no longer needed once deletion was attempted.",
                  "pm.environment.unset('userPassword');"
                ]
              }
            }
          ]
        },
