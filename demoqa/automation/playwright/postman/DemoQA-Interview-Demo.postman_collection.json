                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = undefined; }",
                  "// Observed OBS-API-05 / D3: failure is reported in the body while HTTP stays 200.",
                  "pm.test('API-AC-102 | status is 200 OK even though authentication fails', () => pm.response.to.have.status(200));",
                  "pm.test('API-AC-102 | status is \"Failed\" with the failure message', () => {",
                  "  pm.expect(body.status).to.eql('Failed');",
                  "  pm.expect(body.result).to.eql('User authorization failed.');",
                  "});",
                  "pm.test('API-AC-102 | no token is issued', () => {",
                  "  pm.expect(body.token).to.equal(null);",
                  "  pm.expect(body.expires).to.equal(null);",
                  "});",
                  "pm.test('API-AC-102 | lifecycle token is unchanged', () => pm.expect(pm.environment.get('authToken') === pm.variables.get('tokenBefore'), 'token unchanged').to.be.true);"
                ]
              }
            }
