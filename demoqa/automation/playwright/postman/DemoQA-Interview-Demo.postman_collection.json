    {
      "name": "3 - Negative cases (isolated)",
      "item": [
        {
          "name": "Negative - Duplicate username",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Account/v1/User",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Account",
                "v1",
                "User"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{username}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cases: API-AC-101, API-CT-002"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Prerequisite guard: skip (reported as not run) instead of sending a request with missing or stale data.",
                  "if (!pm.environment.get('userId') || !pm.environment.get('userPassword')) { pm.execution.skipRequest(); }",
                  "// Snapshot lifecycle values in request-scoped variables to prove this negative call does not change them.",
                  "pm.variables.set('userIdBefore', pm.environment.get('userId'));",
                  "pm.variables.set('tokenBefore', pm.environment.get('authToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = undefined; }",
                  "pm.test('API-AC-101 | status is 406 Not Acceptable', () => pm.response.to.have.status(406));",
                  "pm.test('API-AC-101 | error code is \"1204\" and message is \"User exists!\"', () => {",
                  "  pm.expect(body.code).to.eql('1204');",
                  "  pm.expect(body.message).to.eql('User exists!');",
                  "});",
                  "pm.test('API-AC-101 | no user identifier is exposed', () => pm.expect(body).to.not.have.any.keys('userID', 'userId', 'username'));",
                  "pm.test('API-AC-101 | lifecycle userId and token are unchanged', () => {",
                  "  pm.expect(pm.environment.get('userId')).to.eql(pm.variables.get('userIdBefore'));",
                  "  pm.expect(pm.environment.get('authToken') === pm.variables.get('tokenBefore'), 'token unchanged').to.be.true;",
                  "});",
                  "pm.test('API-CT-002 | error code is a number (Swagger MessageModal)', () => pm.expect(typeof body.code, 'type of code').to.eql('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative - Generate Token wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Account/v1/GenerateToken",
              "host": [
                "{{baseUrl}}"
              ],
