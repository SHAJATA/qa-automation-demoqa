                  "// Observed shape {books:[{isbn}]} differs from the documented {isbn} (D5); asserted exactly as observed.",
                  "pm.test('API-BS-002 | response lists exactly the added ISBN', () => pm.expect(body).to.eql({ books: [{ isbn: pm.environment.get('selectedIsbn') }] }));"
                ]
